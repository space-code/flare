{"sections":[],"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"Creating a Custom Product Style","role":"article","roleHeading":"Article","modules":[{"name":"FlareUI"}]},"abstract":[{"text":"Learn how to create a custom style for a product.","type":"text"}],"variants":[{"paths":["\/documentation\/flareui\/creating-custom-product-style"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/creating-custom-product-style","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Custom Product Style","anchor":"Custom-Product-Style","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"code":"FlareUI","type":"codeVoice"},{"type":"text","text":" provides a simple way to customize the appearance of the products. For this, you need to implement an object that conforms to "},{"identifier":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/IProductStyle","isActive":true,"type":"reference"},{"type":"text","text":" and pass it to "},{"code":"SwiftUI\/View\/productViewStyle(_:)","type":"codeVoice"},{"type":"text","text":" or "},{"code":"SwiftUI\/View\/productViewStyle(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use one of the predefined styles that are optimized for various platforms: "},{"type":"codeVoice","code":"LargeProductStyle"},{"type":"text","text":" and "},{"identifier":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/CompactProductStyle","type":"reference","isActive":true},{"type":"text","text":"."}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"Based on the "},{"identifier":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/ProductStyleConfiguration\/State-swift.enum","isActive":true,"type":"reference"},{"type":"text","text":" enum, you can define different views to display for various states."}],"type":"paragraph"},{"code":["struct CustomProductStyle: IProductStyle {","    func makeBody(configuration: Configuration) -> some View {","        switch configuration.state {","        case .loading:","            \/\/ Provide a custom loader view","        case let .product(product):","            \/\/ Provide a custom view that displays the product's info","        case let .error(error):","            \/\/ Provide a view for displaying an error to a user.","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Custom Subscription Control Style","anchor":"Custom-Subscription-Control-Style","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"To create a custom subscription style create an object that conforms to "},{"identifier":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/ISubscriptionControlStyle","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["struct CustomSubscriptionStyle: ISubscriptionControlStyle {","    func makeBody(configuration: SubscriptionStoreControlStyleConfiguration) -> some View {","        VStack {","            configuration.label","                .font(.title)","            configuration.description","                .font(.body)","            configuration.price","                .font(.body)","                .foregroundColor(.blue)","            ","            \/\/ If you need to ttack a selected state","            \/\/ configuration.isSelected","","            \/\/ If the subscription is active","            \/\/ configuration.isActive","            ","            \/\/ Triggers a purchase action","            \/\/ configuration.trigger()","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then, we use can apply the custom style to "},{"identifier":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/SubscriptionsView\/subscriptionControlStyle(_:)","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/SubscriptionsViewController\/subscriptionControlStyle","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/flare.FlareUI\/documentation\/FlareUI"],["doc:\/\/flare.FlareUI\/documentation\/FlareUI","doc:\/\/flare.FlareUI\/documentation\/FlareUI\/displaying-products"]]},"references":{"doc://flare.FlareUI/documentation/FlareUI/ISubscriptionControlStyle":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ISubscriptionControlStyle"}],"abstract":[],"type":"topic","title":"ISubscriptionControlStyle","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ISubscriptionControlStyle"}],"url":"\/documentation\/flareui\/isubscriptioncontrolstyle","identifier":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/ISubscriptionControlStyle"},"doc://flare.FlareUI/documentation/FlareUI":{"kind":"symbol","abstract":[{"type":"text","text":"Display a customizable in-app purchase store using StoreKit views for UIKit and SwiftUI."}],"type":"topic","title":"FlareUI","role":"collection","url":"\/documentation\/flareui","identifier":"doc:\/\/flare.FlareUI\/documentation\/FlareUI"},"doc://flare.FlareUI/documentation/FlareUI/displaying-products":{"kind":"article","abstract":[{"type":"text","text":"Learn how to display a set of products to a user."}],"type":"topic","title":"Displaying Products","role":"collectionGroup","identifier":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/displaying-products","url":"\/documentation\/flareui\/displaying-products"},"doc://flare.FlareUI/documentation/FlareUI/IProductStyle":{"navigatorTitle":[{"text":"IProductStyle","kind":"identifier"}],"abstract":[{"text":"A type that represents a product style.","type":"text"}],"title":"IProductStyle","type":"topic","url":"\/documentation\/flareui\/iproductstyle","kind":"symbol","fragments":[{"