},{"anchor":"Custom-Buttons","level":2,"type":"heading","text":"Custom Buttons"},{"inlineContent":[{"type":"text","text":"If you have restorable products, the "},{"type":"codeVoice","code":"ProductsView"},{"type":"text","text":" can show a restore button to the customer. For this, you can use "},{"type":"codeVoice","code":"SwiftUI\/View\/storeButton(_:types:)-4x8yd"},{"type":"text","text":" or "},{"identifier":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/ProductsViewController\/storeButton(_:types:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ SwiftUI","","ProductsView(ids: [\"com.company.product_id_1\", \"com.company.product_id_2\"])","    .storeButton(.visible, types: .restore)"]},{"syntax":"swift","type":"codeListing","code":["\/\/ UIKit","","let productsVC = ProductsViewController(ids: [\"com.company.product_id_1\", \"com.company.product_id_2\"])","productsVC.storeButton(.visible, types: [.restore])"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flareui\/displaying-products"]}],"sections":[],"identifier":{"url":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/displaying-products","interfaceLanguage":"swift"},"references":{"doc://flare.FlareUI/documentation/FlareUI/ProductsViewController":{"type":"topic","url":"\/documentation\/flareui\/productsviewcontroller","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProductsViewController"}],"navigatorTitle":[{"kind":"identifier","text":"ProductsViewController"}],"abstract":[{"type":"text","text":"A view for displaying multiple products."}],"role":"symbol","title":"ProductsViewController","identifier":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/ProductsViewController","kind":"symbol"},"doc://flare.FlareUI/documentation/FlareUI/handling-transactions":{"type":"topic","url":"\/documentation\/flareui\/handling-transact