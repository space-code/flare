{"topicSections":[{"identifiers":["doc:\/\/flare.FlareUI\/documentation\/FlareUI\/creating-custom-product-style","doc:\/\/flare.FlareUI\/documentation\/FlareUI\/handling-transactions"],"title":"Articles","anchor":"Articles"}],"metadata":{"modules":[{"name":"FlareUI"}],"role":"collectionGroup","title":"Displaying Products"},"hierarchy":{"paths":[["doc:\/\/flare.FlareUI\/documentation\/FlareUI"]]},"kind":"article","abstract":[{"text":"Learn how to display a set of products to a user.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The "},{"code":"FlareUI","type":"codeVoice"},{"type":"text","text":" provides an easy way to display different kinds of products with a single line of code. To display a set of products to the user, just pass a collection of identifiers to the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/flare.FlareUI\/documentation\/FlareUI\/ProductsView"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["ProductsView(ids: [\"com.company.product_id_1\", \"com.company.product_id_2\"])"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Once "},{"type":"codeVoice","code":"ProductsView"},{"type":"text","text":" fetches these products from the App Store, it will display them to the user. If the products can’t be fetched for any reason, the "},{"type":"codeVoice","code":"ProductsView"},{"type":"text","text":" shows a message to the user that the App Store is not available."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"By default, all Flare views use cached data if available; otherwise, they fetch the data. If you want to change this behavior, please read more about Flare configuration ","type":"text"},{"identifier":"link","type":"reference","isActive":true},{"text":".","type":"text"}]}],"type":"aside","style":"impo